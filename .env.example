# PostureGuard environment variables
# ─────────────────────────────────────
# Copy this file to ".env" for local development.
# Never commit a real .env file — it is excluded by .gitignore.

# SQLite (default — works out of the box, no separate DB service needed).
# The file is created automatically in the project root on first startup.
DATABASE_URL=sqlite:///./postureguard.db

# To switch to PostgreSQL (e.g. for a future Render deployment), replace
# the line above with your connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/postureguard

# API key — must match the X-API-Key header sent by the ESP32, NodeMCU,
# and the dashboard.  Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change-me-to-a-long-random-secret
