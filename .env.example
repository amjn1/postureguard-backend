# PostureGuard — environment variables
# ─────────────────────────────────────
# Copy this file to ".env" for local development.
# On Render, set these as Environment Variables in the service dashboard —
# never commit a .env file containing real secrets to Git.

# PostgreSQL connection string.
# On Render this is auto-injected when you link a PostgreSQL database to
# the web service (see render.yaml and the README deploy guide).
DATABASE_URL=postgresql://user:password@localhost:5432/postureguard

# API key shared by the ESP32 wearable node, the NodeMCU desk station,
# and the dashboard.  Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change-me-to-a-long-random-secret
